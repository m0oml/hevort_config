# ── Scope ─────────────────────────────────────────────────────────────────────
# This repo lives ON the live DSF directory: the working tree IS the machine.
# Nothing is copied or synced. Everything is excluded by default and only the
# two configuration directories are let back in.
/*
!/.gitignore
!/sys/
!/macros/

# ── Inside sys/ ───────────────────────────────────────────────────────────────
# heightmap.csv is rewritten by every mesh (printstart.g meshes each print; mesh.g is
# the manual full-bed survey), so it is scratch output, not config. The old
# per-condition maps (heightmap_bed*_ch*.csv) were retired 26/09/2026: they are in git
# history and in hevort_project/survey_data/thermal_map_set_20260919/.
/sys/heightmap.csv

# RRF writes capture output into sys/ and recreates these directories on demand:
#   accelerometer/  M956 input-shaping sweeps (4-6 MB per capture)
#   closed-loop/    M569.5 closed-loop tuning captures
# These are output, not configuration. They are renamed after capture and pulled
# across to hevort_project/survey_data/, which is where they belong.
/sys/accelerometer/
/sys/closed-loop/

# ── Credentials ───────────────────────────────────────────────────────────────
# Belt and braces alongside the pre-commit secret scan. duetBackup kept a
# plaintext GitHub token in sys/ until 19/09/2026.
duetBackup/
*.config.bak
*.pem
*.key

# ── Backup lock ───────────────────────────────────────────────────────────────
# Pause the watcher to batch a few edits into one commit:
#   echo "reason" > sys/BACKUP_PAUSED   pause, and set the eventual commit subject
#   rm sys/BACKUP_PAUSED                resume; everything lands as ONE commit
# Auto-expires after 10 min if forgotten — see hevort_config_watch.sh.
/sys/BACKUP_PAUSED
